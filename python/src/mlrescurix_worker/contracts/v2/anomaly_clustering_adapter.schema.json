{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlrescurix:anomaly-clustering-adapter:2",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "dataset_id",
    "adapter_type",
    "feature_columns",
    "contamination_prior",
    "score_calibration",
    "clustering_protocol",
    "evaluation_profile",
    "delivery_inference"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v2" },
    "adapter_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "adapter_type": {
      "type": "string",
      "enum": ["anomaly_detection", "clustering", "combined"]
    },
    "feature_columns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "contamination_prior": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "exclusiveMaximum": 0.5
    },
    "score_calibration": {
      "type": "object",
      "required": [
        "method",
        "threshold",
        "score_min",
        "score_max",
        "score_mean",
        "score_std",
        "percentiles"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["empirical_percentile", "min_max", "z_score"]
        },
        "threshold": { "type": "number" },
        "score_min": { "type": "number" },
        "score_max": { "type": "number" },
        "score_mean": { "type": "number" },
        "score_std": { "type": "number", "minimum": 0.0 },
        "percentiles": {
          "type": "object",
          "required": ["p05", "p25", "p50", "p75", "p95"],
          "properties": {
            "p05": { "type": "number" },
            "p25": { "type": "number" },
            "p50": { "type": "number" },
            "p75": { "type": "number" },
            "p95": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clustering_protocol": {
      "type": "object",
      "required": ["algorithm", "metric"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["kmeans", "hdbscan", "dbscan"]
        },
        "n_clusters": { "type": ["integer", "null"], "minimum": 2 },
        "metric": {
          "type": "string",
          "enum": ["euclidean", "manhattan", "cosine"]
        },
        "eps": { "type": ["number", "null"], "exclusiveMinimum": 0.0 },
        "min_samples": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "evaluation_profile": {
      "type": "object",
      "required": [
        "silhouette_score",
        "davies_bouldin_index",
        "calinski_harabasz_score",
        "num_noise_points",
        "num_clusters_found"
      ],
      "properties": {
        "silhouette_score": { "type": ["number", "null"], "minimum": -1.0, "maximum": 1.0 },
        "davies_bouldin_index": { "type": ["number", "null"], "minimum": 0.0 },
        "calinski_harabasz_score": { "type": ["number", "null"], "minimum": 0.0 },
        "inertia": { "type": ["number", "null"], "minimum": 0.0 },
        "roc_auc": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "pr_auc": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "num_noise_points": { "type": "integer", "minimum": 0 },
        "num_clusters_found": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "delivery_inference": {
      "type": "object",
      "required": [
        "supports_out_of_sample_scoring",
        "supports_out_of_sample_assignment",
        "anomaly_score_bounded"
      ],
      "properties": {
        "supports_out_of_sample_scoring": { "type": "boolean" },
        "supports_out_of_sample_assignment": { "type": "boolean" },
        "anomaly_score_bounded": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
