{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlrescurix:feasibility-report:2",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "project_id",
    "timestamp_ms",
    "model_family",
    "hardware_profile",
    "dataset_metadata",
    "verdict",
    "confidence",
    "predicted_runtime_ms",
    "predicted_peak_memory_bytes",
    "cv_fold_count",
    "include_final_refit",
    "concurrent_worker_leases",
    "assumptions",
    "pilot_trial_ids",
    "adaptation_proposals"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v2" },
    "report_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "model_family": {
      "type": "string",
      "enum": ["linear", "boosting", "tree", "neural", "custom"]
    },
    "hardware_profile": { "type": "object" },
    "dataset_metadata": { "type": "object" },
    "verdict": {
      "type": "string",
      "enum": ["locally_feasible", "feasible_with_adaptation", "requires_external_compute", "unknown"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "predicted_runtime_ms": {
      "type": "object",
      "required": ["min", "expected", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "expected": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "predicted_peak_memory_bytes": {
      "type": "object",
      "required": ["min", "expected", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "expected": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cv_fold_count": { "type": "integer", "minimum": 1 },
    "include_final_refit": { "type": "boolean" },
    "concurrent_worker_leases": { "type": "integer", "minimum": 1 },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pilot_trial_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "adaptation_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adaptation_type",
          "description",
          "predicted_speedup_factor",
          "predicted_memory_reduction_factor",
          "quality_impact",
          "parameter_adjustments"
        ],
        "properties": {
          "adaptation_type": {
            "type": "string",
            "enum": [
              "streaming",
              "sparse_linear",
              "progressive_fidelity",
              "downsampled_screening",
              "smaller_architecture",
              "quantization"
            ]
          },
          "description": { "type": "string" },
          "predicted_speedup_factor": { "type": "number", "minimum": 1.0 },
          "predicted_memory_reduction_factor": { "type": "number", "minimum": 1.0 },
          "quality_impact": { "type": "string" },
          "parameter_adjustments": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
