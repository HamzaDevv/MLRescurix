{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlrescurix:custom-job-spec:2",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "task_id",
    "generation",
    "intent_revision",
    "operation",
    "model_plugin",
    "dataset_id",
    "metric_name",
    "metric_direction",
    "max_steps",
    "batch_size"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v2" },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "intent_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "operation": {
      "type": "string",
      "enum": ["custom_train", "custom_resume", "custom_evaluate", "custom_export"]
    },
    "model_plugin": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "target_column": { "type": ["string", "null"], "maxLength": 128 },
    "metric_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "metric_direction": { "type": "string", "enum": ["maximize", "minimize"] },
    "max_steps": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "batch_size": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "resume_checkpoint": { "type": ["string", "null"], "maxLength": 1024 },
    "learning_rate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 10.0 },
    "hidden_dim": { "type": ["integer", "null"], "minimum": 1, "maximum": 8192 },
    "seed": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 },
    "resources": {
      "type": ["object", "null"],
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 67108864 },
        "cpu_threads": { "type": "integer", "minimum": 1, "maximum": 64 },
        "timeout_ms": { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
