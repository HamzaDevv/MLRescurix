{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlrescurix:experiment-spec:1",
  "type": "object",
  "required": [
    "experiment_id",
    "session_id",
    "project_id",
    "recipe",
    "parameters",
    "seed",
    "fidelity",
    "node_type"
  ],
  "properties": {
    "experiment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "recipe": { "type": "string", "minLength": 1, "maxLength": 128 },
    "parameters": { "type": "object" },
    "seed": { "type": "integer", "minimum": 0 },
    "fidelity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "parent_experiment_id": { "type": ["string", "null"] },
    "node_type": { "type": "string", "enum": ["baseline", "screening", "full_fidelity", "repeat", "draft", "debug", "improve", "ablate", "candidate"] }
  },
  "additionalProperties": false
}
