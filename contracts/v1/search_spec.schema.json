{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlrescurix:search-spec:1",
  "type": "object",
  "required": [
    "session_id",
    "project_id",
    "dataset_id",
    "target",
    "task",
    "metric",
    "direction",
    "split"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "target": { "type": "string", "minLength": 1, "maxLength": 128 },
    "task": { "type": "string", "enum": ["binary_classification", "multiclass_classification", "regression"] },
    "metric": { "type": "string", "enum": ["balanced_accuracy", "log_loss", "mae", "rmse"] },
    "direction": { "type": "string", "enum": ["maximize", "minimize"] },
    "split": { "type": "string", "enum": ["stratified", "random", "grouped", "chronological"] },
    "fidelities": { "type": "array", "items": { "type": "number", "minimum": 0.1, "maximum": 1.0 } },
    "recipes": { "type": "array", "items": { "type": "string", "enum": ["dummy", "linear", "tree"] } },
    "max_trials": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "max_screen_trials": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "max_full_trials": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "search_wall_ms": { "type": "integer", "minimum": 1000 },
    "job_timeout_ms": { "type": "integer", "minimum": 1000 },
    "finalization_allowance_ms": { "type": "integer", "minimum": 0 },
    "max_repeats": { "type": "integer", "minimum": 1, "maximum": 10 },
    "tie_tolerance": { "type": "number", "minimum": 0.0 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
    "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
    "constraints": { "type": "object" }
  },
  "additionalProperties": false
}
