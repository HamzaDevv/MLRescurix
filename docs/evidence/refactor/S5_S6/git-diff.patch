+fn package_delivery_bundle(
+    state_root: &Path,
+    project_id: &str,
+    candidate_id: &str,
+    branch_dir: &Path,
+    weights_file: &Path,
+    spec: &CampaignProblemSpec,
+    protocol_sha256: &str,
+    feature_columns: &[String],
+    raw_rows_data: &[Vec<String>],
+    val_set: &HashSet<u64>,
+    target_idx: usize,
+    header: &[String],
+    validation_score: f64,
+    lockbox_score: f64,
+) -> Result<PackagedBundleInfo> {
+    let bundle_dir = state_root.join(format!("delivery_bundle_{}", candidate_id));
+    if bundle_dir.exists() {
+        let _ = fs::remove_dir_all(&bundle_dir);
+    }
+    fs::create_dir_all(&bundle_dir).map_err(|e| e.to_string())?;
+
+    // Candidate solution and manifest from branch
+    let branch_sol = branch_dir.join("solution.py");
+    if !branch_sol.is_file() {
+        return Err(format!("candidate solution.py missing in branch workspace '{:?}'", branch_dir));
+    }
+    fs::copy(&branch_sol, bundle_dir.join("solution.py")).map_err(|e| e.to_string())?;
+
+    let program_manifest = if branch_dir.join("program.json").is_file() {
+        let m_bytes = fs::read(branch_dir.join("program.json")).map_err(|e| e.to_string())?;
+        serde_json::from_slice::<Value>(&m_bytes).unwrap_or_else(|_| serde_json::json!({}))
+    } else {
+        serde_json::json!({})
