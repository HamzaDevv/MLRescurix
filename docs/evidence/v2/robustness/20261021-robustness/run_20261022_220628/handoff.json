      "provider_receipt": {
        "content": "{\"proposed_action\": \"RUN_SCRIPT\", \"parameters\": {\"language\": \"python\", \"purpose\": \"Baseline group-disjoint CV for hist_gbdt and penalized_linear on Titanic with family/ticket group mapping\", \"script\": \"import numpy as np, pandas as pd\\nfrom sklearn.model_selection import GroupKFold\\nfrom sklearn.ensemble import HistGradientBoostingClassifier\\nfrom sklearn.linear_model import LogisticRegression\\nfrom sklearn.pipeline import Pipeline\\nfrom sklearn.compose import ColumnTransformer\\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\\nfrom sklearn.impute import SimpleImputer\\n\\n# Load data (path resolved by harness)\\ndf = pd.read_csv(DATA_PATH)\\n\\n# --- Feature engineering ---\\ndef family_ticket_group(row):\\n    # frozen_family_ticket_mapping: surname + ticket prefix grouping\\n    name = str(row['Name'])\\n    surname = name.split(',')[0].strip() if ',' in name else name\\n    ticket = str(row['Ticket'])\\n    tprefix = ticket.split()[0] if ' ' in ticket else 'NUM'\\n    return f\\\"{surname}|{tprefix}\\\"\\n\\ndf['family_ticket_group'] = df.apply(family_ticket_group, axis=1)\\ndf['CabinDeck'] = df['Cabin'].astype(str).str[0].fillna('U').replace('n','U')\\ndf['CabinKnown'] = df['Cabin'].notna().astype(int)\\ndf['FamilySize'] = df['SibSp'] + df['Parch'] + 1\\ndf['IsAlone'] = (df['FamilySize'] == 1).astype(int)\\ndf['FarePerPerson'] = df['Fare'] / df['FamilySize']\\ndf['TicketPrefix'] = df['Ticket'].astype(str).apply(lambda t: t.split()[0] if ' ' in t else 'NUM')\\n\\nnum_cols = ['Pclass','Age','SibSp','Parch','Fare','FamilySize','IsAlone','FarePerPerson','CabinKnown']\\ncat_cols = ['Sex','Embarked','CabinDeck','TicketPrefix']\\n\\nX = df[num_cols + cat_cols].copy()\\ny = df['Survived'].values\\ngroups = df['family_ticket_group'].values\\n\\npre = ColumnTransformer([\\n    ('num', Pipeline([('imp', SimpleImputer(strategy='median')),('sc', StandardScaler())]), num_cols),\\n    ('cat', Pipeline([('imp', SimpleImputer(strategy='most_frequent')),('oh', OneHotEncoder(handle_unknown='ignore'))]), cat_cols),\\n])\\n\\nmodels = {\\n    'hist_gbdt': HistGradientBoostingClassifier(max_iter=300, learning_rate=0.05, max_depth=None, random_state=42),\\n    'penalized_linear': Pipeline([('pre', pre), ('clf', LogisticRegression(C=1.0, max_iter=2000, random_state=42))]),\\n}\\n\\n# hist_gbdt needs its own preprocessing (no scaling needed but needs encoding)\\nfrom sklearn.pipeline import Pipeline as P\\nmodels['hist_gbdt'] = P([('pre', pre), ('clf', HistGradientBoostingClassifier(max_iter=300, learning_rate=0.05, random_state=42))])\\n\\ngkf = GroupKFold(n_splits=5)\\nresults = {}\\nfor name, model in models.items():\\n    accs = []\\n    for tr, va in gkf.split(X, y, groups):\\n        m = model\\n        m.fit(X.iloc[tr], y[tr])\\n        pred = m.predict(X.iloc[va])\\n        accs.append((pred == y[va]).mean())\\n    results[name] = {'mean_acc': float(np.mean(accs)), 'fold_accs': [float(a) for a in accs]}\\n\\nprint('RESULTS', results)\\n\", \"expected_outputs\": [\"RESULTS dict with mean_acc and fold_accs per model\"]}, \"rationale\": \"Prior turns failed on parse errors; this turn submits a concrete, self-contained script that builds the frozen family/ticket group mapping, engineers standard Titanic features, and evaluates both active_spec families (hist_gbdt, penalized_linear) under 5-fold GroupKFold to establish a valid baseline before any tuning.\"}",
